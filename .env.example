# 航策向标 配置模板（A9）—— 复制为 .env 并填入真实凭据；.env 已被 .gitignore 忽略，严禁入库
# ragflow 配置
RAGFLOW_API_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=replace_with_ragflow_api_key

# LLM 配置（当前使用 SiliconFlow OpenAI 兼容网关）
DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1
DASHSCOPE_API_KEY=replace_with_siliconflow_api_key
LLM_QWEN_PLUS=qwen3.6-flash

# tavily 搜索
TAVILY_API_KEY=replace_with_tavily_api_key

# 数据库（pharma_ro 为只读账号，用于 SELECT pharma_db；root 留作备份）
MYSQL_USER=pharma_ro
MYSQL_PASSWORD=replace_with_mysql_password
MYSQL_DATABASE=pharma_db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# A10：/api/task 访问令牌（前端凭此访问，无 token 返回 401）
TASK_API_TOKEN=replace_with_random_token
